# Test configuration (no real secrets). Loaded when NODE_ENV=test.
# Point DATABASE_URL at a disposable database: the test run rolls back, re-migrates and re-seeds it.
# A real environment variable overrides this value, e.g. DATABASE_URL=... npm test
NODE_ENV=test
DATABASE_URL=postgres://postgres:postgres@localhost:5432/quiz_test
JWT_ACCESS_SECRET=test-only-secret-0123456789-abcdefghijklmnop
BCRYPT_COST=4
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_AUTH_PER_MIN=1000
RATE_LIMIT_SUBMIT_PER_MIN=1000
