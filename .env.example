# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL 16+ connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/quiz_dev
# Set to true for managed Postgres that requires TLS (Render external URL, Railway, Neon, ...)
DATABASE_SSL=false

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_COST=12

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173
# Use "none" (with HTTPS) if the client is served from a different site than the API
COOKIE_SAMESITE=strict
# COOKIE_SECURE defaults to true in production
# COOKIE_SECURE=true
# Number of reverse proxies in front of the API (1 on Render or behind Nginx)
TRUST_PROXY=0

RATE_LIMIT_AUTH_PER_MIN=5
RATE_LIMIT_SUBMIT_PER_MIN=10
